generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

enum PullListStatus {
  REQUESTED
  ORDERED
  ARRIVED
  PICKED_UP
  CANCELED
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  role               UserRole
  mustChangePassword Boolean   @default(true)
  isActive           Boolean   @default(true)
  name               String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customer     Customer?
  createdItems PullListItem[] @relation("createdBy")
  updatedItems PullListItem[] @relation("updatedBy")

  uploadedInvoices     VendorInvoice[]             @relation("uploadedInvoices")
  confirmedAllocations InvoiceLineItemAllocation[] @relation("confirmedAllocations")
  receivingScans       InvoiceReceivingScan[]
}

model Customer {
  id          String   @id @default(cuid())
  userId      String?  @unique
  displayName String
  phone       String?
  staffNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User?          @relation(fields: [userId], references: [id])
  pullListItems PullListItem[]
}

model PullListItem {
  id               String         @id @default(cuid())
  customerId       String
  title            String
  issueInfo        String?
  status           PullListStatus @default(REQUESTED)
  internalNotes    String?
  customerNote     String?
  createdByStaffId String
  updatedByStaffId String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User     @relation("createdBy", fields: [createdByStaffId], references: [id])
  updatedBy User     @relation("updatedBy", fields: [updatedByStaffId], references: [id])

  invoiceAllocations InvoiceLineItemAllocation[]
}

model VendorInvoice {
  id                String    @id @default(cuid())
  vendorName        String
  invoiceNumber     String
  invoiceDate       DateTime?
  orderNumber       String?
  subtotal          Decimal?  @db.Decimal(10, 2)
  total             Decimal?  @db.Decimal(10, 2)
  sourceText        String    @db.Text
  uploadedByStaffId String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  uploadedBy User                    @relation("uploadedInvoices", fields: [uploadedByStaffId], references: [id])
  lineItems  VendorInvoiceLineItem[]
  receivingScans InvoiceReceivingScan[]

  @@unique([vendorName, invoiceNumber])
}

model VendorInvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  sku         String?
  description String
  gtin        String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  lineAmount  Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  invoice     VendorInvoice               @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  allocations InvoiceLineItemAllocation[]
  scans       InvoiceReceivingScan[]

  @@index([invoiceId])
}

model InvoiceLineItemAllocation {
  id                 String         @id @default(cuid())
  lineItemId         String
  pullListItemId     String
  quantity           Int
  resultingStatus    PullListStatus
  confirmedByStaffId String
  confirmedAt        DateTime       @default(now())

  lineItem     VendorInvoiceLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  pullListItem PullListItem          @relation(fields: [pullListItemId], references: [id])
  confirmedBy  User                  @relation("confirmedAllocations", fields: [confirmedByStaffId], references: [id])

  @@index([lineItemId])
  @@index([pullListItemId])
}

model InvoiceReceivingScan {
  id                String   @id @default(cuid())
  invoiceId         String
  lineItemId        String?
  scannedCode       String
  scannedByStaffId  String
  scannedAt         DateTime @default(now())

  invoice    VendorInvoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  lineItem   VendorInvoiceLineItem? @relation(fields: [lineItemId], references: [id], onDelete: SetNull)
  scannedBy  User                   @relation(fields: [scannedByStaffId], references: [id])

  @@index([invoiceId])
  @@index([lineItemId])
}
